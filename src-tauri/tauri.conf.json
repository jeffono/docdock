{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "DocDock",
  "version": "0.1.0-beta.3",
  "identifier": "com.jeffono.docdock",
  "build": {
    "beforeDevCommand": "pnpm dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "pnpm build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "create": false,
        "dragDropEnabled": false,
        "title": "DocDock",
        "x": 0,
        "y": 0,
        "width": 460,
        "height": 600,
        "visible": false,
        "focus": false,
        "decorations": false,
        "resizable": false,
        "shadow": false
      }
    ],
    "security": {
      "csp": {
        "default-src": "'none'",
        "script-src": "'self'",
        "style-src": "'self'",
        "img-src": "'self' http://note-asset.localhost",
        "connect-src": "http://ipc.localhost",
        "object-src": "'none'",
        "base-uri": "'none'",
        "form-action": "'none'",
        "frame-src": "'none'"
      }
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "createUpdaterArtifacts": true,
    "windows": {
      "nsis": {
        "languages": ["English", "PortugueseBR"],
        "installMode": "currentUser"
      },
      "webviewInstallMode": {
        "type": "downloadBootstrapper"
      }
    }
  },
  "plugins": {
    "updater": {
      "windows": {
        "installMode": "passive"
      },
      "endpoints": ["https://github.com/jeffono/docdock/releases/latest/download/latest.json"],
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDkzMUNDNjhGRDAyODg0NEEKUldSS2hDalFqOFljay8rRHVidVNvekhBUkZVMTRBR2svZWV6VzNobU0rT2YwNzAxd2ZHdlNidUEK"
    }
  }
}
