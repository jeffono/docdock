{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "DocDock",
  "version": "0.1.0",
  "identifier": "com.jeffono.docdock",
  "build": {
    "beforeDevCommand": "pnpm dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "pnpm build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "create": false,
        "title": "DocDock",
        "x": 0,
        "y": 0,
        "width": 460,
        "height": 600,
        "visible": false,
        "focus": false,
        "decorations": false,
        "resizable": false,
        "shadow": false
      }
    ],
    "security": {
      "csp": {
        "default-src": "'none'",
        "script-src": "'self'",
        "style-src": "'self'",
        "img-src": "'self' http://note-asset.localhost",
        "connect-src": "http://ipc.localhost",
        "object-src": "'none'",
        "base-uri": "'none'",
        "form-action": "'none'",
        "frame-src": "'none'"
      }
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
