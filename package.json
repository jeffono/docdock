{
  "name": "docdock",
  "version": "0.1.0-beta.3",
  "description": "Autohide sidebar for viewing, adding, and editing references",
  "license": "MIT",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@12.6.0",
  "scripts": {
    "dev": "vite dev",
    "build": "vite build",
    "prepare": "git config core.hooksPath .githooks",
    "tauri": "tauri",
    "test": "vitest run --passWithNoTests --reporter=dot",
    "clean": "node scripts/clean.mjs",
    "format": "biome check --write . && cargo fmt --manifest-path src-tauri/Cargo.toml",
    "check": "pnpm --silent check:fast && pnpm --silent test && pnpm --silent check:rust",
    "check:fast": "biome check . && node scripts/check-colors.mjs && pnpm --silent check:types && cargo fmt --manifest-path src-tauri/Cargo.toml --check",
    "check:types": "svelte-check --tsconfig ./tsconfig.json --output human",
    "check:rust": "cargo clippy -q --manifest-path src-tauri/Cargo.toml --all-targets -- -D warnings && cargo test -q --manifest-path src-tauri/Cargo.toml"
  },
  "dependencies": {
    "@codemirror/autocomplete": "^6.20.4",
    "@codemirror/commands": "^6.11.1",
    "@codemirror/lang-markdown": "^6.5.2",
    "@codemirror/language": "^6.13.1",
    "@codemirror/search": "^6.7.2",
    "@codemirror/state": "^6.7.6",
    "@codemirror/view": "^6.43.15",
    "@lezer/common": "^1.5.5",
    "@lezer/css": "^1.3.9",
    "@lezer/highlight": "^1.2.5",
    "@lezer/html": "^1.3.13",
    "@lezer/javascript": "^1.5.6",
    "@lezer/json": "^1.0.3",
    "@lezer/markdown": "^1.8.1",
    "@tauri-apps/api": "^2"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.6.4",
    "@sveltejs/vite-plugin-svelte": "^7.1.2",
    "@tauri-apps/cli": "^2",
    "svelte": "^5.56.3",
    "svelte-check": "^4.6.0",
    "typescript": "~6.0.3",
    "vite": "^8.0.16",
    "vitest": "^5.0.5"
  }
}
